{
  "manifest_version": 3,
  "name": "Synco Extension",
  "description": "Coffre de clés local pour Synco (uniquement sur les origines Synco) et actions de page.",
  "version": "0.0.0",
  "permissions": [
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Synco Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
